//Practice 1:Remove char from string
console.log("Practice 1: Remove char from string");
{
let s = "banana";
let ch = "n";

const result = s.split(ch).join('');
console.log(result);

/*
- split() breaks a string into pieces.
- join() combines those pieces into a string again.
Together, split(ch).join('') removes all occurrences of ch from the original string.
*/
}

